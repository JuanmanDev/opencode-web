# password protecting the opencode API (internal; the web app injects it)
OPENCODE_SERVER_PASSWORD=change-me

# host folder that contains your projects (mounted at /projects in the container)
PROJECTS_DIR=./projects

# domain Traefik routes to the web UI
WEB_DOMAIN=opencode.example.com

# provider API keys used by opencode
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
